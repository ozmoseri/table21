# Copy to .env only if you need overrides. Never commit real values.

# PostgreSQL. Omit to use the embedded PGlite database in .data/embedded.
DATABASE_URL=postgres://t21@127.0.0.1:55432/table21
# Integration tests database (local cluster from scripts/db.mjs).
T21_TEST_DATABASE_URL=postgres://t21@127.0.0.1:55432/table21_test

# Server
HOST=127.0.0.1
PORT=3021
# online | lan
T21_DEPLOYMENT=online
# Embedded database directory (when DATABASE_URL is not set)
T21_DATA_DIR=.data/embedded
# Built web client served by the server
T21_WEB_DIST=apps/web/dist
# Optional HTTPS for LAN (PEM file paths, e.g. created with mkcert)
T21_TLS_CERT=
T21_TLS_KEY=
# 1 = short timers for automated tests, 1 = request logging
T21_FAST=0
T21_LOG=0

# Local Postgres helper (scripts/db.mjs)
T21_PG_PORT=55432
# Unprivileged OS user to run Postgres as when the shell is root
T21_PG_RUNAS=
# Directory containing initdb/pg_ctl if not on PATH
PG_BIN=
