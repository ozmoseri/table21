# Copy to .env only if you need overrides. Never commit real values.

# PostgreSQL. Omit to use the embedded PGlite database in .data/embedded.
DATABASE_URL=postgres://t21@127.0.0.1:55432/table21
# Integration tests database (local cluster from scripts/db.mjs).
T21_TEST_DATABASE_URL=postgres://t21@127.0.0.1:55432/table21_test

# Server
HOST=127.0.0.1
PORT=3021
# online | lan
T21_DEPLOYMENT=online
# Embedded database directory (when DATABASE_URL is not set)
T21_DATA_DIR=.data/embedded
# Built web client served by the server
T21_WEB_DIST=apps/web/dist
# Optional HTTPS for LAN (PEM file paths, e.g. created with mkcert)
T21_TLS_CERT=
T21_TLS_KEY=
# 1 = short timers for automated tests, 1 = request logging
T21_FAST=0
T21_LOG=0

# Local Postgres helper (scripts/db.mjs)
T21_PG_PORT=55432
# Unprivileged OS user to run Postgres as when the shell is root
T21_PG_RUNAS=
# Directory containing initdb/pg_ctl if not on PATH
PG_BIN=

# Sign-in providers (Stage C). Leave empty: the UI then shows them as "not set up on this server".
# Google Identity Services: the Web client ID (public, not a secret). Needs an HTTPS public origin.
T21_GOOGLE_CLIENT_ID=
# Facebook Login for the Web: App ID (public) and App Secret (server only, never in the client or the repo).
T21_FACEBOOK_APP_ID=
T21_FACEBOOK_APP_SECRET=
# Graph API version for the JS SDK and debug_token (default v26.0).
T21_FACEBOOK_GRAPH_VERSION=
# Public HTTPS origin of a deployed server, for example https://table21.example. Required before enabling providers.
T21_PUBLIC_ORIGIN=
# Automated tests only. Startup fails if set together with NODE_ENV=production, LAN mode or T21_PUBLIC_ORIGIN.
T21_TEST_AUTH=0

# Free-tier pilot (docs/DEPLOY.md). render-free turns on the operator card; on Render it is on by default.
T21_PILOT_PLAN=
# ISO date the free database was created (defaults to the first migration time).
T21_PILOT_DB_CREATED=
# Comma separated operator user ids (defaults to the first account created on the server).
T21_ADMIN_USER_IDS=
